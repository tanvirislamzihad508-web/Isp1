<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="java.sql.*,com.isp.db.DBConnection"%>
<% int billId=Integer.parseInt(request.getParameter("billId")); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Invoice</title>
<style>body{font-family:Arial;padding:30px;max-width:700px;margin:auto;}
h2{border-bottom:2px solid #333;padding-bottom:5px;}
table{width:100%;border-collapse:collapse;margin-top:20px;}
td,th{border:1px solid #999;padding:8px;}
@media print{.no-print{display:none;}}</style></head><body>
<button class="no-print" onclick="window.print()" style="padding:8px 16px;margin-bottom:20px; cursor:pointer;">🖨 Print / Save as PDF</button>
<h2>ISP Bill Invoice</h2>
<%
  String q="SELECT C.NAME,C.PHONE,C.AREA,P.PACKAGE_NAME,B.BILL_MONTH,B.AMOUNT,B.DUE_DATE,B.STATUS "+
           "FROM BILL B JOIN SUBSCRIPTION S ON B.SUBSCRIPTION_ID=S.SUBSCRIPTION_ID "+
           "JOIN CUSTOMER C ON S.CUSTOMER_ID=C.CUSTOMER_ID "+
           "JOIN PACKAGE P ON S.PACKAGE_ID=P.PACKAGE_ID WHERE B.BILL_ID=?";
  try(Connection c=DBConnection.getConnection(); PreparedStatement ps=c.prepareStatement(q)){
    ps.setInt(1,billId);
    ResultSet r=ps.executeQuery();
    if(r.next()){ %>
      <p><b>Customer:</b> <%=r.getString(1)%> (<%=r.getString(2)%>)<br><b>Area:</b> <%=r.getString(3)%></p>
      <table>
        <tr><th>Bill ID</th><td><%=billId%></td></tr>
        <tr><th>Package</th><td><%=r.getString(4)%></td></tr>
        <tr><th>Month</th><td><%=r.getString(5)%></td></tr>
        <tr><th>Amount</th><td><%=r.getDouble(6)%> Tk</td></tr>
        <tr><th>Due Date</th><td><%=r.getDate(7)%></td></tr>
        <tr><th>Status</th><td><%=r.getString(8)%></td></tr>
      </table>
      <p style="margin-top:40px;font-size:12px;">Generated by ISP Management System</p>
    <% }
  } %>
</body></html>